<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        联网权限：OkHttp 发请求必须要有，否则会抛 SecurityException（提示 missing INTERNET permission）。
        它属于普通权限，安装时自动授予，不需要运行时申请。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        从相册选图走系统文件选择器（SAF），不需要申请任何存储权限；
        如果换成自己读 MediaStore 的老写法，Android 13+ 要申请 READ_MEDIA_IMAGES，反而更麻烦。
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyFirstApp"
        android:usesCleartextTraffic="true">

        <!--
            usesCleartextTraffic="true" —— 允许明文 HTTP。
            Android 9（API 28）起系统默认禁止 http:// 请求，不打开这个开关会直接报
            "CLEARTEXT communication to 192.168.x.x not permitted by network security policy"。
            演示环境走的是局域网 http，所以放开；正式项目应该用 https，
            或者用 res/xml/network_security_config.xml 只对特定域名放开。
        -->

        <activity
            android:name=".OkHttpActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
