<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainTextColorActivity"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_color_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hello"
        android:textSize="30sp"
        />
    <!--  xml中 六位十六进制数，透明度 默认 ff  -->
    <TextView
        android:id="@+id/tv_color_xml"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hello"
        android:textSize="30sp"
        android:textColor="@color/green"
        />
    <TextView
        android:id="@+id/tv_color_xml_purple_200"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hello"
        android:textSize="30sp"
        android:textColor="@color/purple_200"
        />
    <TextView
        android:id="@+id/tv_color_xml_purple_500"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hello"
        android:textSize="30sp"
        android:textColor="@color/purple_500"
        />

    <TextView
        android:id="@+id/tv_color_background_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hello"
        android:textSize="30sp"
        android:textColor="@color/purple_500"
        />

    <TextView
        android:id="@+id/tv_color_background_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hello"
        android:textSize="30sp"
        android:textColor="@color/purple_600"
        android:background="@color/black"
        />


</LinearLayout>