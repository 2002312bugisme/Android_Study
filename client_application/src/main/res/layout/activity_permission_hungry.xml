<?xml version="1.0" encoding="utf-8"?>
<!--
    饿汉式权限申请页：进入页面就自动申请全部权限，没有"先点按钮"这一步
    对照 activity_permission_lazy.xml（点了按钮才申请，才是懒汉式）

    根节点必须有 android:id="@+id/main"，Activity 用它做 EdgeToEdge 的系统栏内边距补偿。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".PermissionHungryActivity">

    <!-- 标题条：白底整宽，用来区分两个页面 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:text="动态权限申请（饿汉式）"
        android:textColor="#222222"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 一行说明：这一页和懒汉式页的唯一区别 -->
    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:text="进入页面就申请全部权限（通讯录 + 短信），不等用户点按钮"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <!-- 权限状态：由 Activity 的 refreshStatus() 写入；放在按钮上方，因为本页的主反馈是自动申请的结果 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:lineSpacingExtra="4dp"
        android:padding="14dp"
        android:textColor="#444444"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_desc" />

    <!--
        下面两个按钮不是"饿汉式"的必要部分，纯粹是为了方便重测单组权限
        （比如只拒了短信，想再试一次而不必清应用数据）。
        追求纯粹的饿汉式页面，可以把它们和 Activity 里对应的绑定一起删掉。
    -->
    <Button
        android:id="@+id/btn_request_contacts"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:text="重新申请通讯录权限"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_status" />

    <Button
        android:id="@+id/btn_request_sms"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="重新申请短信权限"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_request_contacts" />

</androidx.constraintlayout.widget.ConstraintLayout>
