<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Intent"
        android:textSize="20dp"
        />

    <Button
        android:id="@+id/btn_displayed_intent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="跳转到B页面"
        android:textColor="@color/black"
        android:textSize="20sp"
        />

    <Button
        android:id="@+id/btn_implicit_intent_tel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="跳转到拨号页面"
        android:textColor="@color/black"
        android:textSize="20sp"
        />

    <Button
        android:id="@+id/btn_implicit_intent_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="跳转到短信页面"
        android:textColor="@color/black"
        android:textSize="20sp"
        />

    <Button
        android:id="@+id/btn_implicit_intent_my"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="跳转到我的页面"
        android:textColor="@color/black"
        android:textSize="20sp"
        />




</LinearLayout>