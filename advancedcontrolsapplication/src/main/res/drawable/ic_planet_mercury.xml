<?xml version="1.0" encoding="utf-8"?>

<!--
    列表项图标：水星（灰蓝色圆底 + 白色环形山）
    对应 Java：advancedcontrolsapplication/.../pojo/Planet.java（getDefaultPlanets 里的第一条）

    画布 24x24，导出 48dp，与本模块其它列表图标同一套画法（见 ic_item_person.xml 的说明）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 行星本体：圆心 (12,12)、半径 10 的整圆 -->
    <path
        android:fillColor="#78909C"
        android:pathData="M2,12 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 z" />

    <!-- 环形山一：圆心 (9,10)、半径 1.6 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9,8.4 a1.6,1.6 0 1,0 0,3.2 a1.6,1.6 0 1,0 0,-3.2 z" />

    <!-- 环形山二：圆心 (14.8,15)、半径 1.1 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M14.8,13.9 a1.1,1.1 0 1,0 0,2.2 a1.1,1.1 0 1,0 0,-2.2 z" />

</vector>
