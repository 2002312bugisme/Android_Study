<?xml version="1.0" encoding="utf-8"?>

<!--
    生命周期观察页布局
    对应 LifeCycleTestActivity：上面显示实例标识与屏幕方向，下面滚动显示生命周期时间线
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 视觉留白放内层：根布局的 padding 会被 insets 的 setPadding 覆盖 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 实例标识 + 当前方向：旋转后 hashCode 变了，说明 Activity 被重建了 -->
        <TextView
            android:id="@+id/tv_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="旋转手机（模拟器用 Ctrl+← 或 Ctrl+→），观察下面的调用顺序"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <!-- 时间线：等宽字体，一行一条，方便对照 -->
        <ScrollView
            android:id="@+id/sv_log"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="13sp" />

        </ScrollView>

    </LinearLayout>

</LinearLayout>
