<?xml version="1.0" encoding="utf-8"?>

<!--
    列表项图标：加号（用于「添加快捷入口」这一行）
    对应 Java：advancedcontrolsapplication/.../SimpleAdapterActivity.java（Map 里的 KEY_ICON）

    十字由「竖条 + 横条」两个矩形并集而成，一条 pathData 就能画完：
    从左上角起笔，顺时针绕一圈回到起点。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 圆形底板 -->
    <path
        android:fillColor="#E91E63"
        android:pathData="M2,12 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 z" />

    <!-- 白色十字（粗 3.6 的竖条 + 横条） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.2,5.8 h3.6 v4.4 h4.4 v3.6 h-4.4 v4.4 h-3.6 v-4.4 h-4.4 v-3.6 h4.4 z" />

</vector>
