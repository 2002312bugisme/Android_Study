<?xml version="1.0" encoding="utf-8"?>

<!--
    SimpleAdapter 图文列表演示页布局
    对应 Java：advancedcontrolsapplication/src/main/java/com/zzz/advancedcontrolsapplication/SimpleAdapterActivity.java

    结构说明：标题说明 + 一个 ListView（撑满剩余高度）+ 底部一行点击结果回显。
             每一行的样子不在这里定义，而在 res/layout/item_simple_adapter.xml —— 那才是 SimpleAdapter 的「行布局」。
-->

<!-- 根布局只负责铺满屏；内边距交给内层容器（原因见下） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
        ⚠️ 内层容器承担 16dp 留白。
        根布局上不要直接写 android:padding：Java 里 OnApplyWindowInsetsListener 调的是
        setPadding(...)，会把 XML 设的内边距整体覆盖成系统栏尺寸，两者会打架。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 小标题只做说明，不参与逻辑 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SimpleAdapter：图片 + 文字"
            android:textSize="16sp" />

        <!--
            列表本体。
            关键属性：
              · android:layout_height="0dp" + layout_weight="1" —— 高度交给 LinearLayout 分配，
                把标题与底部回显之外的剩余空间全吃掉，行数变多时列表内部自己滚动，而不是把页面撑长。
              · android:divider 引用 ?android:attr/listDivider（系统给的分隔线 drawable，深浅色主题各自对应），
                比写死 #EEEEEE 更能适配深色模式；dividerHeight 只调线宽。
        -->
        <ListView
            android:id="@+id/list_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:divider="?android:attr/listDivider"
            android:dividerHeight="1dp" />

        <!-- 点击结果回显：核心 API 的结论落在这句上 -->
        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="点击列表项试试"
            android:textSize="16sp" />

        <!--
            页面导航按钮：跳到 BaseAdapterActivity，用来对照「同一份列表用两种适配器写」。
            那一页在清单里是 exported=false，adb 的 am start 直接拉不起来时可以从这里进。
        -->
        <Button
            android:id="@+id/btn_open_base_adapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="打开 BaseAdapter 版本（自建适配器）" />

    </LinearLayout>

</LinearLayout>
