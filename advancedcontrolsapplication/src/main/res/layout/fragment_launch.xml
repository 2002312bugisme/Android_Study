<?xml version="1.0" encoding="utf-8"?>

<!--
    引导页的单页布局（Fragment 版）
    对应 LaunchFragment#onCreateView：整屏图片 + 底部圆点 + 最后一页的入口按钮
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 图片铺满整页；centerCrop 而不是 fitXY，避免被系统栏压缩后变形 -->
    <ImageView
        android:id="@+id/iv_launch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!--
        底部圆点指示器，子 View 由 LaunchFragment 按 image_count 动态添加。
        width 必须 wrap_content，写 match_parent 时 centerHorizontal 会失效、整排贴左下角。
    -->
    <RadioGroup
        android:id="@+id/rg_indicate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="20dp" />

    <!-- 最后一页的入口按钮，默认隐藏，由代码在 position == imageCount-1 时显示 -->
    <Button
        android:id="@+id/btn_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/rg_indicate"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:text="立即开始美好生活"
        android:textSize="18sp"
        android:visibility="gone" />

</RelativeLayout>
