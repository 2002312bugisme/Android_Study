<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical">

    <!-- 页面标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="18dp"
        android:text="ImageView ScaleType"
        android:textColor="#202124"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- 图片滚动区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">


            <!-- fitCenter -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="fitCenter"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_scale_fitCenter"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:contentDescription="@string/image_description"
                android:scaleType="fitCenter"
                android:src="@drawable/tos_cn" />


            <!-- centerCrop -->
            <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="centerCrop"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_scale_centerCrop"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:contentDescription="@string/image_description"
                android:scaleType="centerCrop"
                android:src="@drawable/tos_cn" />
            <!-- center -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="center"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- centerInside -->
            <ImageView
                android:id="@+id/image_scale_center"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:contentDescription="@string/image_description"
                android:scaleType="center"
                android:src="@drawable/tos_cn" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="centerInside"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_scale_centerInside"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:contentDescription="@string/image_description"
                android:scaleType="centerInside"
                android:src="@drawable/tos_cn" />
            <!-- fitXY -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="fitXY"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_scale_fitXY"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:contentDescription="@string/image_description"
                android:scaleType="fitXY"
                android:src="@drawable/tos_cn" />


            <!-- fitStart -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="fitStart"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_scale_fitStart"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:contentDescription="@string/image_description"
                android:scaleType="fitStart"
                android:src="@drawable/tos_cn" />


            <!-- fitEnd -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="fitEnd"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_scale_fitEnd"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:contentDescription="@string/image_description"
                android:scaleType="fitEnd"
                android:src="@drawable/tos_cn" />


            <!-- matrix -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="matrix"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_scale_matrix"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:contentDescription="@string/image_description"
                android:scaleType="matrix"
                android:src="@drawable/tos_cn" />

            <!-- ImageButton -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="ImageButton"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/image_btn"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:contentDescription="@string/image_description"
                android:scaleType="fitCenter"
                android:src="@drawable/tos_cn" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="submit"
                android:drawableStart="@drawable/tos_cn"
                android:drawablePadding="8dp" />

        </LinearLayout>



    </ScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/tos_cn"
            android:scaleType="centerInside" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="submit" />

    </LinearLayout>

</LinearLayout>