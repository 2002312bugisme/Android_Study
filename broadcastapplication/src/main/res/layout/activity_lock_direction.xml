<?xml version="1.0" encoding="utf-8"?>

<!--
    锁定屏幕方向演示页布局
    对应 LockDirectionActivity：清单里 android:screenOrientation="portrait" 锁死竖屏
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".LockDirectionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="清单里的 android:screenOrientation 决定初始锁定方向\n代码 setRequestedOrientation 可以在运行时改（会触发重建）\n无论哪种，旋转手机本页都不会跟着转"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <!-- 演示另一种锁定方式：代码调用 setRequestedOrientation -->
        <Button
            android:id="@+id/btn_switch_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="改成锁定横屏（代码设置）" />

    </LinearLayout>

</LinearLayout>
