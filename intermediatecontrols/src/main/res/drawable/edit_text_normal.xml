<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!--轮廓的粗细和颜色-->
    <stroke
        android:width="2dp"
        android:color="#aaaaaa" />

    <!--填充颜色-->
    <solid android:color="@color/white" />

    <!--四个角半径-->
    <corners android:radius="5dp" />

    <!--方向间距-->
    <padding
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp" />
</shape>